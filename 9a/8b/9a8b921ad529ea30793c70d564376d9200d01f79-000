<!doctype html>
<!-- 20 October 2026, 18:28 CEST: native toggles keep the article contents accessible without scripts. -->
<html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{TITLE}}</title>
<style>
{{FONTS}}
:root{--paper:#f7f6f2;--ink:#242923;--muted:#636b60;--accent:#51633e;--line:#dedfd6;--panel:#eeeee7;--sans:'InterVariable',sans-serif;--serif:'AnthropicSerif Medium',serif;--mono:'AnthropicMono',monospace;--width:980px;--body:18px;--space:24px;--weight:500;--sidebar-width:210px;--sidebar-gap:32px;--edge:20px;--sidebar-radius:12px}
*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:24px}body{margin:0;background:var(--paper);color:var(--ink);font:var(--weight) var(--body)/1.65 var(--serif)}a{color:var(--accent);text-underline-offset:4px}.article-layout{max-width:1400px;margin:auto;padding:56px var(--edge) 48px}main{max-width:var(--width);margin:auto;min-width:0}header{border-bottom:1px solid var(--line);padding-bottom:26px}.eyebrow,.meta,summary,th,.step-no,.status{font:500 12px/1.5 var(--sans)}.eyebrow{text-transform:uppercase;letter-spacing:.1em;color:var(--muted)}h1{font:500 clamp(38px,5.5vw,64px)/1.1 var(--serif);letter-spacing:-.03em;margin:16px 0}h2{font:500 clamp(26px,3.4vw,34px)/1.2 var(--serif);letter-spacing:-.02em;margin:0 0 16px}h3{font:500 21px/1.35 var(--serif);margin:0 0 10px}.lead{max-width:760px;font-size:22px;line-height:1.5;margin:16px 0}.meta{color:var(--muted);display:flex;gap:12px;flex-wrap:wrap}.status{color:var(--accent)}.hero{display:grid;grid-template-columns:minmax(0,280px) minmax(0,1fr);gap:24px;align-items:center;margin:24px 0 0}.hero img{width:100%;min-width:0;aspect-ratio:1;object-fit:contain;border-radius:var(--sidebar-radius);background:white}.hero p{margin:0}.hero .caption{font:500 12px/1.5 var(--sans);color:var(--muted);margin-top:12px}section{padding:32px 0;border-bottom:1px solid var(--line);scroll-margin-top:24px}section>.eyebrow{display:none}p{margin:0 0 14px}p:last-child{margin-bottom:0}figure{margin:20px 0}figure img{width:100%;height:auto;max-height:500px;object-fit:contain;display:block;border-radius:10px;border:1px solid var(--line);background:white}figcaption{font:500 12px/1.55 var(--sans);color:var(--muted);margin-top:9px}.figure-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(280px,100%),1fr));gap:18px;align-items:start;margin:20px 0}.figure-grid figure{margin:0}.figure-grid img{max-height:360px}.steps{display:grid;grid-template-columns:repeat(5,1fr);gap:14px;margin:20px 0}.step{padding:0 12px 0 0;border-right:1px solid var(--line)}.step:last-child{border:0}.step-no{color:var(--muted);display:block;margin-bottom:6px}.step h3{font:500 14px/1.4 var(--sans)}.step p{font-size:15px;line-height:1.5}.callout{border-left:2px solid var(--line);padding:4px 18px;margin:18px 0}.prompt{padding:14px 0;border-top:1px solid var(--line);margin:12px 0}summary{cursor:pointer;font-size:14px;line-height:1.5;color:var(--ink)}details[open]>summary{margin-bottom:14px}.prompt-text{font:500 14px/1.75 var(--sans);white-space:pre-wrap;overflow-wrap:anywhere;user-select:all;margin:0}.table-wrap{max-width:100%;overflow-x:auto}table{border-collapse:collapse;width:100%;font:500 13px/1.6 var(--sans)}td,th{text-align:left;vertical-align:top;border-bottom:1px solid var(--line);padding:10px 8px}th{color:var(--muted);padding-top:0}code{font:500 11px/1.65 var(--mono);overflow-wrap:anywhere}footer{padding-top:24px;font:500 12px/1.5 var(--sans);color:var(--muted)}.muted{color:var(--muted)}
.toc-state{position:fixed;width:1px;height:1px;clip-path:inset(50%);overflow:hidden;white-space:nowrap}.toc-open-button{position:fixed;z-index:30;top:14px;left:var(--edge);padding:7px 12px;background:var(--paper);border:1px solid var(--line);border-radius:8px;font:500 12px/1.4 var(--sans);cursor:pointer;user-select:none}.article-sidebar{position:fixed;z-index:25;top:60px;bottom:var(--edge);left:var(--edge);width:var(--sidebar-width);display:flex;flex-direction:column;min-height:0;padding:16px 12px;background:var(--paper);border:1px solid var(--line);border-radius:var(--sidebar-radius);font:500 13px/1.5 var(--sans)}.toc-header{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:18px}.toc-header strong{font-weight:500;font-size:13px}.toc-pin{font-size:11px;color:var(--muted);cursor:pointer;padding:4px 6px;border-radius:5px}.toc-pin:hover,.toc-links a:hover{background:var(--panel);color:var(--ink)}.toc-links{display:flex;flex-direction:column;gap:4px;overflow-y:auto;min-height:0}.toc-links a{display:block;color:var(--muted);text-decoration:none;padding:7px 9px;border-radius:6px;line-height:1.4}.toc-links a:focus-visible{outline:2px solid var(--accent);outline-offset:-2px}.toc-footer{margin-top:auto;padding-top:20px;color:var(--muted);font-size:11px}.when-hidden,.when-unpinned{display:none}#toc-open:not(:checked)~.toc-open-button .when-open{display:none}#toc-open:not(:checked)~.toc-open-button .when-hidden{display:inline}#toc-open:not(:checked)~.article-layout .article-sidebar{display:none}#toc-open:checked~#toc-pin:checked~.article-layout{padding-left:calc(var(--sidebar-width) + var(--sidebar-gap) + var(--edge))}#toc-pin:not(:checked)~.article-layout .article-sidebar{bottom:auto;max-height:calc(100vh - 80px);box-shadow:0 12px 36px rgb(0 0 0 / .12)}#toc-pin:not(:checked)~.article-layout .when-pinned{display:none}#toc-pin:not(:checked)~.article-layout .when-unpinned{display:inline}#toc-open:focus-visible~.toc-open-button,#toc-pin:focus-visible~.article-layout .toc-pin{outline:2px solid var(--accent);outline-offset:3px}
@media(prefers-color-scheme:dark){:root{--paper:#20231f;--ink:#eff0e7;--muted:#b4bbae;--accent:#becda5;--line:#41483b;--panel:#2b3028}}
/* 20 October 2026, 18:35 CEST: a narrow frame starts with its own closed drawer; the desktop pin never covers the article. */
.toc-mobile-button,#toc-mobile-open{display:none}
@media(max-width:800px){.toc-desktop-button,#toc-open,#toc-pin,.toc-pin{display:none}.toc-mobile-button,#toc-mobile-open{display:block}#toc-mobile-open:not(:checked)~.toc-mobile-button .when-open{display:none}#toc-mobile-open:not(:checked)~.toc-mobile-button .when-hidden{display:inline}#toc-mobile-open:checked~.toc-mobile-button .when-hidden{display:none}#toc-mobile-open:checked~.toc-mobile-button .when-open{display:inline}#toc-open:checked~#toc-pin:checked~.article-layout{padding-left:var(--edge)}#toc-mobile-open:not(:checked)~.article-layout .article-sidebar{display:none}#toc-mobile-open:checked~.article-layout .article-sidebar{display:flex}.article-sidebar{width:min(260px,calc(100vw - 40px));bottom:auto;max-height:calc(100vh - 80px);box-shadow:0 12px 36px rgb(0 0 0 / .12)}.hero{grid-template-columns:minmax(0,200px) minmax(0,1fr)}#toc-mobile-open:focus-visible~.toc-mobile-button{outline:2px solid var(--accent);outline-offset:3px}}
@media(max-width:560px){.article-layout{padding-top:64px}.hero{grid-template-columns:1fr}.hero img{max-width:260px;margin:auto}.lead{font-size:20px}.steps{grid-template-columns:1fr;gap:10px}.step{border:0;display:grid;grid-template-columns:28px 1fr;gap:0 8px}.step h3{margin-bottom:2px}.step p{grid-column:2}.step-no{margin:0}section{padding:26px 0}.figure-grid{grid-template-columns:1fr}body{font-size:17px}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.article-layout{transition:none}}
</style></head><body>
<input class="toc-state" type="checkbox" id="toc-open" aria-label="Afficher le sommaire" checked>
<input class="toc-state" type="checkbox" id="toc-mobile-open" aria-label="Afficher le sommaire sur vue étroite">
<input class="toc-state" type="checkbox" id="toc-pin" aria-label="Épingler le sommaire" checked>
<label for="toc-open" class="toc-open-button toc-desktop-button"><span class="when-open">Masquer le sommaire</span><span class="when-hidden">Sommaire</span></label>
<label for="toc-mobile-open" class="toc-open-button toc-mobile-button"><span class="when-open">Masquer le sommaire</span><span class="when-hidden">Sommaire</span></label>
<div class="article-layout"><aside class="article-sidebar" aria-label="Sommaire de l’article"><div class="toc-header"><strong>{{TITLE}}</strong><label class="toc-pin" for="toc-pin"><span class="when-pinned">Détacher</span><span class="when-unpinned">Épingler</span></label></div><nav class="toc-links" aria-label="Sommaire">{{NAV}}</nav><div class="toc-footer">{{SUBTITLE}}</div></aside><main>
<header id="article-opening"><div class="eyebrow">{{EYEBROW}}</div><h1>{{TITLE}}</h1><p class="lead">{{LEAD}}</p><div class="meta"><span>{{DATE}}</span><span>{{SUBTITLE}}</span><span class="status">{{STATUS}}</span></div><div class="hero"><img src="{{HERO}}" alt="{{HERO_ALT}}"><div><p>{{HERO_TEXT}}</p><p class="caption">{{HERO_CAPTION}}</p></div></div></header>
{{SECTIONS}}
<footer>{{FOOTER}}</footer>
</main></div></body></html>
