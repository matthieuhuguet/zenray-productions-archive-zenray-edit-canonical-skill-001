<!doctype html>
<!-- 20 October 2026, 14:55 CEST: editable project article, rendered from one JSON definition. -->
<html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{TITLE}}</title>
<style>
{{FONTS}}
:root{--paper:#f7f6f2;--ink:#242923;--muted:#636b60;--accent:#51633e;--line:#dedfd6;--panel:#eeeee7;--sans:'InterVariable',sans-serif;--serif:'AnthropicSerif Medium',serif;--mono:'AnthropicMono',monospace;--width:1100px;--body:19px;--space:28px;--weight:500}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font:var(--weight) var(--body)/1.75 var(--serif)}main{max-width:var(--width);margin:auto;padding:52px 34px 72px}a{color:var(--accent);text-underline-offset:4px}header{border-bottom:1px solid var(--line);padding-bottom:38px}.eyebrow,nav,.meta,summary,th,.step-no,.status{font:500 13px/1.5 var(--sans)}.eyebrow{text-transform:uppercase;letter-spacing:.13em;color:var(--muted)}h1{font:500 clamp(46px,7vw,86px)/1.07 var(--serif);letter-spacing:-.035em;margin:22px 0}h2{font:500 clamp(28px,4vw,42px)/1.2 var(--serif);letter-spacing:-.02em;margin:0 0 22px}h3{font:500 24px/1.35 var(--serif);margin:0 0 12px}.lead{max-width:810px;font-size:24px;line-height:1.55;margin:18px 0 22px}.meta{color:var(--muted);display:flex;gap:12px;flex-wrap:wrap}.status{border:1px solid var(--line);border-radius:24px;padding:5px 12px;color:var(--accent)}nav{display:flex;gap:16px;flex-wrap:wrap;margin-top:25px}nav a{text-decoration:none}.hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:20px;align-items:center;margin:30px 0 0}.hero img{width:100%;min-width:0;aspect-ratio:1;object-fit:contain;border-radius:20px;background:white}.hero p{margin:0}.hero h3{margin-top:14px}.hero .caption{font:500 13px/1.5 var(--sans);color:var(--muted);margin-top:12px}section{padding:48px 0;border-bottom:1px solid var(--line)}p{margin:0 0 20px}p:last-child{margin-bottom:0}figure{margin:28px 0}figure img{width:100%;height:auto;display:block;border-radius:16px;border:1px solid var(--line);background:white}figcaption{font:500 14px/1.65 var(--sans);color:var(--muted);margin-top:13px}.pair{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:22px}.pair figure{margin:0}.steps{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;margin:26px 0}.step{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:18px 15px}.step-no{color:var(--accent);display:block;margin-bottom:8px}.step h3{font:500 16px/1.4 var(--sans)}.step p{font-size:16px;line-height:1.55}.callout{background:var(--panel);border-left:3px solid var(--accent);padding:24px 28px;border-radius:0 14px 14px 0;margin:25px 0}.prompt{padding:22px;border:1px solid var(--line);border-radius:16px;margin:16px 0;background:var(--panel)}summary{cursor:pointer;font-size:16px;line-height:1.5}details[open] summary{margin-bottom:18px}.prompt-text{font:500 16px/1.8 var(--sans);white-space:pre-wrap;overflow-wrap:anywhere;user-select:all;margin:0}.table-wrap{max-width:100%;overflow-x:auto}table{border-collapse:collapse;width:100%;font:500 14px/1.7 var(--sans)}td,th{text-align:left;vertical-align:top;border-bottom:1px solid var(--line);padding:13px 12px}th{color:var(--muted);padding-top:0}code{font:500 12px/1.7 var(--mono);overflow-wrap:anywhere}ul{padding-left:24px}li{margin:8px 0}.muted{color:var(--muted)}footer{padding-top:30px;font:500 13px/1.6 var(--sans);color:var(--muted)}.legend{display:flex;gap:14px;flex-wrap:wrap;font:500 13px/1.5 var(--sans)}.legend span{padding:8px 12px;border:1px solid var(--line);border-radius:20px}
@media(prefers-color-scheme:dark){:root{--paper:#20231f;--ink:#eff0e7;--muted:#b4bbae;--accent:#becda5;--line:#41483b;--panel:#2b3028}}
@media(max-width:680px){main{padding:30px 20px 48px}.hero,.pair{grid-template-columns:1fr}.hero img{max-height:390px}.lead{font-size:21px}.steps{grid-template-columns:1fr}.step{display:grid;grid-template-columns:30px 1fr;gap:6px}.step p{grid-column:2}.step-no{margin:0}section{padding:34px 0}.prompt{padding:16px}body{font-size:18px}td,th{padding:10px 8px}.pair{gap:28px}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style></head><body><main>
<header><div class="eyebrow">{{EYEBROW}}</div><h1>{{TITLE}}</h1><p class="lead">{{LEAD}}</p><div class="meta"><span>{{DATE}}</span><span>{{SUBTITLE}}</span><span class="status">{{STATUS}}</span></div><div class="hero"><img src="{{HERO}}" alt="{{HERO_ALT}}"><div><span class="eyebrow">Le principe</span><h3>Le modèle donne la place.<br>Le concept donne la matière.</h3><p>{{HERO_TEXT}}</p><p class="caption">{{HERO_CAPTION}}</p></div></div><nav aria-label="Sommaire">{{NAV}}</nav></header>
{{SECTIONS}}
<footer>{{FOOTER}}</footer>
</main></body></html>
