// Usage: node CheckFontSet.cjs <article.html> <screenshot.png>. 26 October 2026: loads the gtultra article in an isolated headless Chromium and reports the real font of titles, numbers, body and UI.
const { chromium } = require('/Users/zenray/.claude/skills/zenray-edit/scripts/RenderComposition.cjs').loadPlaywright({});
const url = 'file://' + process.argv[2];
(async () => {
  const browser = await chromium.launch({ headless: true });
  for (const width of [1280, 375]) {
    const page = await browser.newPage({ viewport: { width, height: 900 } });
    await page.goto(url); await page.evaluate(() => document.fonts.ready);
    const r = await page.evaluate(() => {
      const fam = (el) => el ? getComputedStyle(el).fontFamily.split(',')[0].replace(/['"]/g, '') + ' ' + getComputedStyle(el).fontWeight + ' ' + getComputedStyle(el).textTransform + ' ls=' + getComputedStyle(el).letterSpacing : null;
      const q = (s) => document.querySelector(s);
      return {
        h1: fam(q('h1')), h2: fam(q('h2')), num: fam(q('.num')), p: fam(q('p')), th: fam(q('th')) || fam(q('td')), code: fam(q('code')),
        loaded: ['GT Ultra', 'GT Standard L', 'Literata'].map((f) => f + '=' + document.fonts.check(`16px "${f}"`)),
        overflow: document.documentElement.scrollWidth - document.documentElement.clientWidth,
        faces: [...document.fonts].filter((f) => f.status === 'loaded').map((f) => f.family + ' ' + f.weight).join(' | '),
      };
    });
    console.log(width, JSON.stringify(r));
    if (width === 1280) await page.screenshot({ path: process.argv[3], clip: { x: 0, y: 0, width: 1280, height: 700 } });
    await page.close();
  }
  await browser.close();
})();
