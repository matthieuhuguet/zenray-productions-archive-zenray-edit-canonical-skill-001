    output_path.write_text(text, encoding="utf-8")


def encode_movie(
    backgrounds: dict[str, dict[str, Any]],
    title_layer: Image.Image,
    subtitle_variants: dict[str, tuple[Image.Image, Image.Image]],
    output_path: Path,
) -> None:
    width = PARAMS["matrix_width"]
    height = PARAMS["matrix_height"]
    fps = PARAMS["fps"]
    frame_count = int(PARAMS["movie_seconds"] * fps)
    command = [
        "ffmpeg",
        "-y",
        "-f",
        "rawvideo",
        "-pix_fmt",
        "rgb24",
        "-s",
        f"{width}x{height}",
        "-r",
        str(fps),
        "-i",
        "-",
        "-vf",
        f"scale={PARAMS['master_width']}:{PARAMS['master_height']}:flags=lanczos",
        "-c:v",
        "hevc_videotoolbox",
        "-tag:v",
        "hvc1",
        "-b:v",
        "18M",
        "-pix_fmt",
        "yuv420p",
        "-movflags",
        "+faststart",
        str(output_path),
    ]
    process = subprocess.Popen(command, stdin=subprocess.PIPE)
    assert process.stdin is not None
    try:
        for frame_index in range(frame_count):
            time_value = frame_index / fps
            frame = compose_video_frame(time_value, backgrounds, title_layer, subtitle_variants)
            process.stdin.write(np.asarray(frame.convert("RGB"), dtype=np.uint8).tobytes())
    finally:
        process.stdin.close()
    return_code = process.wait()
    if return_code != 0:
        raise RuntimeError(f"MOV encoding failed with exit code {return_code}")


def encode_mp4(movie_path: Path, output_path: Path) -> None:
    command = [
        "ffmpeg",
        "-y",
        "-i",
        str(movie_path),
        "-c:v",
        "libx264",
        "-crf",
        "17",
        "-preset",
        "medium",
        "-pix_fmt",
        "yuv420p",
        "-movflags",
        "+faststart",
        str(output_path),
    ]
    result = subprocess.run(command, check=False)
    if result.returncode != 0:
        raise RuntimeError(f"MP4 encoding failed with exit code {result.returncode}")


def require_files() -> None:
    for spec in BACKGROUND_SPECS.values():
        if not Path(spec["path"]).is_file():
            raise FileNotFoundError(spec["path"])
    for font_spec in [*TITLE_FONTS.values(), *SUBTITLE_FONTS.values()]:
        if not Path(font_spec["path"]).is_file():
            raise FileNotFoundError(font_spec["path"])


def main() -> None:
    require_files()
    ensure_output_dirs()
    matrix_width = PARAMS["matrix_width"]
    matrix_height = PARAMS["matrix_height"]
    gradient = build_gradient(matrix_width, matrix_height)
    title_layers = {
        (title_key, title_color_key): build_title_layer(
            title_key,
            matrix_width,
            matrix_height,
            gradient,
            title_color_key,
        )
        for title_key in TITLE_FONTS
        for title_color_key in TITLE_COLOR_KEYS
    }
    backgrounds = {
        key: prepare_background(key, matrix_width, matrix_height)
        for key in BACKGROUND_SPECS
    }
    subtitle_layers: dict[tuple[str, str], tuple[Image.Image, Image.Image]] = {}
    subtitle_meta: dict[tuple[str, str], dict[str, Any]] = {}
    for subtitle_key in (ACTIVE_SUBTITLE_KEY,):
        for color_key in SUBTITLE_COLORS:
            first, second, meta = build_subtitle_layers(
                subtitle_key,
                color_key,
                matrix_width,
                matrix_height,
            )
            subtitle_layers[(subtitle_key, color_key)] = (first, second)
            subtitle_meta[(subtitle_key, color_key)] = meta

    entries: list[dict[str, Any]] = []
    index = 1
    for background_key, background in backgrounds.items():
        for (title_key, title_color_key), title_layer in title_layers.items():
            for subtitle_key in (ACTIVE_SUBTITLE_KEY,):
                for color_key in SUBTITLE_COLORS:
                    filename = (
                        f"{index:03d}_{background_key}_{title_key}_{title_color_key}_{subtitle_key}_{color_key}.png"
                    )
                    path = OUTPUT_DIR / "matrix" / filename
                    frame = compose_static(
                        background,
                        title_layer,
                        subtitle_layers[(subtitle_key, color_key)],
                    )
                    frame.convert("RGB").save(path, quality=95)
                    entries.append(
                        {
                            "index": index,
                            "path": str(path),
                            "background": background_key,
                            "background_short": BACKGROUND_SHORT_NAMES[background_key],
                            "title_font": TITLE_FONTS[title_key]["label"],
                            "title_short": title_key.replace("_", " "),
                            "title_color": title_color_key,
                            "title_color_short": TITLE_COLOR_SPECS[title_color_key]["label"],
                            "subtitle_font": SUBTITLE_FONTS[subtitle_key]["label"],
                            "subtitle_short": subtitle_key.replace("_", " "),
                            "subtitle_color": color_key,
                            "color_short": color_key.replace("_hint", ""),
                        }
                    )
                    index += 1

    build_contact_sheet(entries, OUTPUT_DIR / PARAMS["matrix_sheet_name"])

    canonical_width = PARAMS["master_width"]
    canonical_height = PARAMS["master_height"]
    canonical_gradient = build_gradient(canonical_width, canonical_height)
    canonical_title_layers = {
        (title_key, title_color_key): build_title_layer(
            title_key,
            canonical_width,
            canonical_height,
            canonical_gradient,
            title_color_key,
        )
        for title_key in TITLE_FONTS
        for title_color_key in TITLE_COLOR_KEYS
    }
    canonical_backgrounds = {
        key: prepare_background(key, canonical_width, canonical_height)
        for key in BACKGROUND_SPECS
    }
    canonical_color_by_background = {
        "blue_layer_01": "yellow",
        "red_layer_02": "white",
        "black_layer_04": "white",
    }
    font_variant_entries = build_font_variant_frames(
        canonical_backgrounds,
        canonical_title_layers,
    )
    canonical_title_key = ("gt_sectra", "white")
    canonical_subtitle_key = ACTIVE_SUBTITLE_KEY
    frame_paths: dict[str, Path] = {}
    for background_key, background in canonical_backgrounds.items():
        color_key = canonical_color_by_background[background_key]
        first, second, _ = build_subtitle_layers(
            canonical_subtitle_key,
            color_key,
            canonical_width,
            canonical_height,
        )
        frame = compose_static(
            background,
            canonical_title_layers[canonical_title_key],
            (first, second),
        )
        frame_path = OUTPUT_DIR / "frames" / f"frame-{BACKGROUND_SHORT_NAMES[background_key].lower()}-style-v4.png"
        frame.convert("RGB").save(frame_path, quality=95)
        frame_paths[background_key] = frame_path

    movie_subtitle_variants: dict[str, tuple[Image.Image, Image.Image]] = {}
    for background_key, color_key in canonical_color_by_background.items():
        first, second, _ = build_subtitle_layers(
            canonical_subtitle_key,
            color_key,
            matrix_width,
            matrix_height,
        )
        movie_subtitle_variants[background_key] = (first, second)
    movie_path = OUTPUT_DIR / "video" / PARAMS["movie_name"]
    encode_movie(
        backgrounds,
        title_layers[canonical_title_key],
        movie_subtitle_variants,
        movie_path,
    )
    encode_mp4(movie_path, OUTPUT_DIR / "video" / PARAMS["mp4_name"])

    write_metadata(entries, font_variant_entries, OUTPUT_DIR / "metadata.json")
    write_readme(entries, font_variant_entries, OUTPUT_DIR / "README.md")
    print(
        json.dumps(
            {
                "output_dir": str(OUTPUT_DIR),
                "matrix_count": len(entries),
                "font_variant_count": len(font_variant_entries),
                "sheet": str(OUTPUT_DIR / PARAMS["matrix_sheet_name"]),
                "frames": {key: str(value) for key, value in frame_paths.items()},
                "mov": str(movie_path),
                "mp4": str(OUTPUT_DIR / "video" / PARAMS["mp4_name"]),
            },
            indent=2,
        )
    )


if __name__ == "__main__":
    try:
        main()
    except Exception as error:
        print(f"ERROR: {error}", file=sys.stderr)
        raise
