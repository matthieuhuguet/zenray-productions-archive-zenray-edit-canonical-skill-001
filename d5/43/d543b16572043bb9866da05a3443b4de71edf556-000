    if (process.argv.length < 3) throw new Error('Usage: node bind-media.mjs <media-file> [media-file ...]')
    console.log(JSON.stringify(bindMediaBatch(process.argv.slice(2))))
  } catch (error) { console.error(error.message); process.exitCode = 1 }
}
