  sfxRepo: '/Users/zenray/Create/Build/Productions/GithubProductions/ZenRaySFX',
  editRepo: '/Users/zenray/Create/Build/Productions/GithubProductions/ZenRayEdit',
  motionBankDir: '/Users/zenray/.claude/tmp/tmp-zenray-motion-design/motion-bank/sfx',
  targetLufs: -14.0,
  limiterCeilingDb: -1.5,
