// 9 November 2026: the article generator defaults to the Adobe Clean font set and never emits GT Ultra by default; older sets stay selectable.
// FR : le défaut produit Adobe Clean et aucune GT Ultra ; sectra, gtstandard et gtultra restent sélectionnables.
import {test} from 'node:test'
import assert from 'node:assert/strict'
import fs from 'node:fs/promises'
import path from 'node:path'
import os from 'node:os'
import {createHash} from 'node:crypto'
import {renderProjectArticle,ARTICLE_SETTINGS} from './render-project-article.mjs'

async function fixture(t, extra = {}) {
  const root = await fs.mkdtemp(path.join(os.tmpdir(), 'zr-render-article-test-')); t.after(() => fs.rm(root, {recursive: true, force: true}))
  const png = Buffer.from('iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNkYPhfDwAChwGA60e6kgAAAABJRU5ErkJggg==', 'base64')
  await fs.writeFile(path.join(root, 'hero.png'), png)
  await fs.writeFile(path.join(root, 'Sources.json'), JSON.stringify({files: [{id: 'hero', path: 'hero.png', bytes: png.length, sha256: createHash('sha256').update(png).digest('hex'), originalPath: '/tmp/hero.png'}]}))
  const config = {sources: 'Sources.json', title: 'Test 12 points', eyebrow: 'e', lead: 'l', date: '9 November 2026', subtitle: 's', status: 'ok', heroAlt: 'a', heroText: 't', heroCaption: 'c', footer: 'f', hero: 'hero', theme: 'galerie',
    sections: [{id: 'one', title: 'Résultat 3', html: '<p>33 583 points en 2,4 s</p>'}], ...extra}
  await fs.writeFile(path.join(root, 'config.json'), JSON.stringify(config))
  return {config: path.join(root, 'config.json'), out: path.join(root, 'index.html')}
}
const render = async (t, extra) => { const f = await fixture(t, extra); await renderProjectArticle(f.config, f.out); return fs.readFile(f.out, 'utf8') }

test('the default font set is adobeclean', () => assert.equal(ARTICLE_SETTINGS.defaultFontSet, 'adobeclean'))
test('the default output uses Adobe Clean and no GT Ultra', async t => {
  const html = await render(t)
  assert.match(html, /font-family:'Adobe Clean'/)
  assert.match(html, /fontSet adobeclean/)
  assert.doesNotMatch(html, /GT Ultra/)
})
test('older font sets stay selectable', async t => {
  assert.match(await render(t, {fontSet: 'gtultra'}), /font-family:'GT Ultra'/)
  assert.match(await render(t, {fontSet: 'gtstandard'}), /font-family:'GT Standard L'/)
  assert.match(await render(t, {fontSet: 'sectra'}), /font-family:'GT Sectra LCG'/)
})
test('an unknown font set is refused', async t => { await assert.rejects(render(t, {fontSet: 'nope'}), /Unknown fontSet/) })
