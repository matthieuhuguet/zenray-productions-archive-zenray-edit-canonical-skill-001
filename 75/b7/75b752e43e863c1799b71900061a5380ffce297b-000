<!doctype html>
<!-- 29 October 2026 : grading slider page generated by scripts/build-grading-sliders.py. FR : page de curseurs d'étalonnage. -->
<html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Étalonnage Bayou</title>
<style>
@font-face{font-family:'GT Ultra';src:url(data:font/woff2;base64,{{FONT_GTULTRA}}) format('woff2');font-weight:400}
@font-face{font-family:'Literata';src:url(data:font/woff2;base64,{{FONT_LITERATA}}) format('woff2');font-weight:200 900}
:root{--bg:#f4f3f0;--panel:#fff;--ink:#1f1f1e;--mute:#6f6e69;--line:rgba(31,31,30,.12);--accent:#0a84ff;--ok:#1d9b4a;--bad:#d03b3b;--t:.2s;--font-ui:'GT Ultra',-apple-system,sans-serif;--font-body:'Literata',Georgia,serif}
@media(prefers-color-scheme:dark){:root{--bg:#161615;--panel:#212120;--ink:#f1f0ec;--mute:#a09f98;--line:rgba(255,255,255,.12)}}
@media(prefers-reduced-motion:reduce){:root{--t:0s}}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:400 15px/1.5 var(--font-body)}
.wrap{max-width:1440px;margin:0 auto;padding:16px;display:grid;grid-template-columns:minmax(0,1fr) 340px;gap:16px}
@media(max-width:900px){.wrap{grid-template-columns:1fr}}
h1{font:400 22px/1.2 var(--font-ui);margin:0 0 4px}.note{color:var(--mute);font-size:13px;margin:0 0 12px}
.stage{background:#000;border-radius:12px;overflow:hidden;position:relative;aspect-ratio:21/9}
canvas{width:100%;height:100%;display:block}
.thumbs{display:flex;gap:8px;margin-top:10px;flex-wrap:wrap}
.thumbs button{font:400 14px var(--font-ui);padding:8px 14px;border-radius:10px;border:1px solid var(--line);background:var(--panel);color:var(--ink);cursor:pointer;transition:background var(--t),border-color var(--t)}
.thumbs button[aria-pressed=true]{border-color:var(--accent);background:color-mix(in srgb,var(--accent) 14%,var(--panel))}
.panel{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:16px;height:max-content;position:sticky;top:16px}
.row{margin:0 0 14px}.row label{display:flex;justify-content:space-between;font:400 14px var(--font-ui)}
.row output{font-variant-numeric:tabular-nums;color:var(--accent)}
input[type=range]{width:100%;accent-color:var(--accent)}
.btns{display:flex;gap:8px;flex-wrap:wrap;margin-top:6px}
.btns button{font:400 14px var(--font-ui);padding:9px 14px;border-radius:10px;border:1px solid var(--line);background:var(--bg);color:var(--ink);cursor:pointer;transition:background var(--t)}
.btns button.main{background:var(--accent);border-color:var(--accent);color:#fff}
#status{min-height:20px;font:400 13px var(--font-ui);margin-top:8px;display:flex;align-items:center;gap:8px}
.spin{width:14px;height:14px;border-radius:50%;border:2px solid var(--line);border-top-color:var(--accent);animation:sp .7s linear infinite}@keyframes sp{to{transform:rotate(360deg)}}
@media(prefers-reduced-motion:reduce){.spin{animation-duration:2s}}
code{font:12px ui-monospace,monospace;background:var(--bg);padding:8px;border-radius:8px;display:block;word-break:break-all;margin-top:10px;color:var(--mute)}
</style></head><body><div class="wrap">
<main><h1 id="title"></h1><p class="note">Aperçu approché des 8 valeurs sur les vues neutres d'Unreal. Copie les valeurs, je les applique dans Unreal et je mesure l'écart.</p>
<div class="stage"><canvas id="cv" aria-label="Aperçu"></canvas></div>
<div class="thumbs" id="thumbs"></div></main>
<aside class="panel"><div id="sliders"></div>
<div class="btns"><button class="main" id="copy">Copier les valeurs</button><button id="reset">Valeurs Unreal actuelles</button><button id="hold" title="Maintenir pour voir la vue neutre">Maintenir : neutre</button><button id="auto" aria-pressed="false">Swap auto</button></div>
<div id="status" role="status"></div><code id="out"></code></aside></div>
<script>
// 29 October 2026 : data injected by the builder / FR : données injectées par le générateur
const CFG={{CONFIG_JSON}};const IMGS={{IMAGES_JSON}};
const clamp=(v,a,b)=>Math.min(b,Math.max(a,v));
const S2L=new Float32Array(256);for(let i=0;i<256;i++){const c=i/255;S2L[i]=c<=.04045?c/12.92:Math.pow((c+.055)/1.055,2.4)}
const L2S=new Uint8Array(4096);for(let i=0;i<4096;i++){const c=i/4095;L2S[i]=Math.round(255*(c<=.0031308?c*12.92:1.055*Math.pow(c,1/2.4)-.055))}
function bb(T){T=clamp(T,1000,40000)/100;let r,g,b;r=T<=66?255:clamp(329.698727446*Math.pow(T-60,-.1332047592),0,255);g=T<=66?clamp(99.4708025861*Math.log(T)-161.1195681661,0,255):clamp(288.1221695283*Math.pow(T-60,-.0755148492),0,255);b=T>=66?255:T<=19?0:clamp(138.5177312231*Math.log(T-10)-305.0447927307,0,255);return[r/255,g/255,b/255]}
// grade(): approximate preview in LINEAR light, like Unreal before its tonemapper; constants K = CFG.model fitted on real Unreal renders. FR : aperçu approché en lumière linéaire.
function grade(src,V,out){const K=CFG.model,e=Math.pow(2,V.exposure_ev*K.ek),ref=bb(6500),w=bb(V.temperature);
 const m=[0,1,2].map(c=>Math.pow(ref[c]/w[c],K.wbk));const mr=e*m[0],mg=e*m[1]*(1-K.tk*V.tint),mb=e*m[2];
 const ig=1/(1+(V.gamma-1)*K.gk),cc=1+(V.contrast-1)*K.ck,sk=1+(V.saturation-1)*K.sk,P=K.p;
 for(let i=0;i<src.length;i+=4){let r=S2L[src[i]]*mr,g=S2L[src[i+1]]*mg,b=S2L[src[i+2]]*mb;
  r=Math.pow(Math.max(r,1e-6),ig);g=Math.pow(Math.max(g,1e-6),ig);b=Math.pow(Math.max(b,1e-6),ig);
  r=P*Math.pow(r/P,cc);g=P*Math.pow(g/P,cc);b=P*Math.pow(b/P,cc);
  const y=clamp(.2126*r+.7152*g+.0722*b,0,4);const ws=1-clamp(y/K.ts,0,1),wh=clamp((y-K.th)/(1-K.th),0,1);
  const s=sk*(1+(V.shadows_saturation-1)*K.shk*ws)*(1+(V.highlights_saturation-1)*K.hik*wh);
  r=y+(r-y)*s;g=y+(g-y)*s;b=y+(b-y)*s;
  out[i]=L2S[clamp(Math.round(r*4095),0,4095)];out[i+1]=L2S[clamp(Math.round(g*4095),0,4095)];out[i+2]=L2S[clamp(Math.round(b*4095),0,4095)];out[i+3]=255}}
window.grade=grade;
const cv=document.getElementById('cv'),ctx=cv.getContext('2d',{willReadFrequently:true});
const decoded=[];let cur=0,V={},raf=0,hold=false;
const NEUTRAL=Object.fromEntries(Object.entries(CFG.sliders).map(([k,s])=>[k,s.neutral]));
const DEFAULT=Object.fromEntries(Object.entries(CFG.sliders).map(([k,s])=>[k,s.default]));
try{const saved=JSON.parse(localStorage.getItem('grading-'+CFG.id)||'null');V=Object.assign({},DEFAULT,saved||{})}catch(e){V=Object.assign({},DEFAULT)}
function draw(){raf=0;const d=decoded[cur];if(!d)return;const o=new ImageData(d.width,d.height);grade(d.data,hold?NEUTRAL:V,o.data);ctx.putImageData(o,0,0)}
function schedule(){if(!raf)raf=requestAnimationFrame(draw)}
function line(){return JSON.stringify(Object.fromEntries(Object.keys(CFG.sliders).map(k=>[k,+(+V[k]).toFixed(4)])))}
function refresh(){document.getElementById('out').textContent=line();try{localStorage.setItem('grading-'+CFG.id,JSON.stringify(V))}catch(e){}schedule()}
function build(){const box=document.getElementById('sliders');for(const[k,s]of Object.entries(CFG.sliders)){const row=document.createElement('div');row.className='row';
 row.innerHTML=`<label for="s_${k}"><span>${s.label}</span><output id="o_${k}"></output></label><input id="s_${k}" type="range" min="${s.min}" max="${s.max}" step="${s.step}">`;box.appendChild(row);
 const inp=row.querySelector('input'),o=row.querySelector('output');const set=()=>{o.textContent=(+V[k]).toFixed(s.step<.1?2:s.step<1?2:0)};inp.value=V[k];set();
 inp.addEventListener('input',()=>{V[k]=+inp.value;set();refresh()});inp.addEventListener('dblclick',()=>{V[k]=s.default;inp.value=s.default;set();refresh()});row._sync=()=>{inp.value=V[k];set()}}}
function syncAll(){document.querySelectorAll('.row').forEach(r=>r._sync&&r._sync())}
function select(i){cur=(i+IMGS.length)%IMGS.length;[...document.querySelectorAll('.thumbs button')].forEach((b,j)=>b.setAttribute('aria-pressed',j===cur));schedule()}
const status=document.getElementById('status');
document.getElementById('copy').addEventListener('click',async()=>{status.innerHTML='<span class="spin"></span>Copie en cours';try{await navigator.clipboard.writeText(line());status.style.color='var(--ok)';status.textContent='Copié, colle-le dans le chat.'}catch(e){status.style.color='var(--bad)';status.textContent='Copie impossible : sélectionne la ligne ci-dessous.'}});
document.getElementById('reset').addEventListener('click',()=>{V=Object.assign({},DEFAULT);syncAll();refresh()});
const hb=document.getElementById('hold');['pointerdown'].forEach(ev=>hb.addEventListener(ev,()=>{hold=true;schedule()}));['pointerup','pointerleave'].forEach(ev=>hb.addEventListener(ev,()=>{hold=false;schedule()}));
let timer=0;const ab=document.getElementById('auto');ab.addEventListener('click',()=>{const on=ab.getAttribute('aria-pressed')!=='true';ab.setAttribute('aria-pressed',on);clearInterval(timer);if(on)timer=setInterval(()=>select(cur+1),CFG.auto_swap_seconds*1000)});
addEventListener('keydown',e=>{if(e.key>='1'&&e.key<='9'&&+e.key<=IMGS.length)select(+e.key-1);if(e.key==='ArrowRight')select(cur+1);if(e.key==='ArrowLeft')select(cur-1)});
document.getElementById('title').textContent=CFG.title;
IMGS.forEach((im,i)=>{const b=document.createElement('button');b.textContent=im.label;b.addEventListener('click',()=>select(i));document.getElementById('thumbs').appendChild(b)});
build();
Promise.all(IMGS.map(im=>new Promise((res,rej)=>{const i=new Image();i.onload=()=>{const c=document.createElement('canvas');c.width=i.naturalWidth;c.height=i.naturalHeight;const x=c.getContext('2d');x.drawImage(i,0,0);res(x.getImageData(0,0,c.width,c.height))};i.onerror=rej;i.src=im.src}))).then(ds=>{ds.forEach((d,i)=>decoded[i]=d);cv.width=ds[0].width;cv.height=ds[0].height;window.__ready=true;select(0);refresh()}).catch(()=>{status.style.color='var(--bad)';status.textContent='Images illisibles.'});
</script></body></html>
