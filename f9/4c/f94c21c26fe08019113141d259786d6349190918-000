<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{PAGE_TITLE}}</title>
  <style id="embedded-fonts">
{{FONT_FACES}}
  </style>
  <style>
    :root {
      --bg: #FDFDFC;
      --ink: #1F1F1E;
      --muted: #6b6b67;
      --faint: #9a9a96;
      --border: #e6e6e2;
      --hairline: rgba(31, 31, 30, 0.10);
      --accent: #0A84FF;
      --chip: rgba(120, 120, 128, 0.08);

      --font-ultra: 'ZRUltra', 'GT Ultra', -apple-system, BlinkMacSystemFont, sans-serif;
      --font-literata: 'ZRLiterata', 'Literata', Georgia, serif;

      --page-size: A4;
      --margin-top: 14mm;
      --margin-side: 16mm;
      --margin-bottom: 14mm;

      --footer-left: "{{FOOTER_LEFT}}";
      --footer-right: "{{FOOTER_RIGHT}}";

      --font-name: 20pt;
      --font-role: 9.5pt;
      --font-meta: 7.5pt;
      --font-recipient-company: 9.5pt;
      --font-recipient-details: 8.5pt;
      --font-date: 8.5pt;
      --font-subject: 9.6pt;
      --font-salutation: 9pt;
      --font-body: 8.8pt;
      --font-bullet: 8.6pt;
      --font-signoff: 8.8pt;
      --font-sig-name: 11pt;
      --font-sig-role: 8.5pt;
      --font-footer: 6.8pt;

      --line-height: 1.48;
      --line-height-tight: 1.35;

      --gap-header: 4.5mm;
      --gap-meta: 5mm;
      --gap-subject: 4mm;
      --gap-salutation: 3.5mm;
      --gap-paragraph: 3.2mm;
      --gap-bullet: 1.8mm;
      --gap-signature: 4.5mm;
    }

    @page {
      size: var(--page-size);
      margin: var(--margin-top) var(--margin-side) var(--margin-bottom) var(--margin-side);
      background: var(--bg);
      @bottom-left {
        content: var(--footer-left);
        font-family: var(--font-ultra);
        font-weight: 400;
        font-size: var(--font-footer);
        color: var(--faint);
        vertical-align: top;
        padding-top: 4mm;
      }
      @bottom-right {
        content: counter(page) " / " counter(pages);
        font-family: var(--font-ultra);
        font-weight: 400;
        font-size: var(--font-footer);
        color: var(--faint);
        vertical-align: top;
        padding-top: 4mm;
      }
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      background: var(--bg);
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
      font-kerning: normal;
      text-rendering: geometricPrecision;
    }

    body {
      background: var(--bg);
      color: var(--ink);
      font-family: var(--font-literata);
      font-weight: 400;
      font-size: var(--font-body);
      line-height: var(--line-height);
      hyphens: manual;
      overflow-wrap: break-word;
      max-width: 210mm;
      margin: 0 auto;
      padding: 0;
    }

    @media screen {
      body {
        padding: var(--margin-top) var(--margin-side) var(--margin-bottom) var(--margin-side);
        min-height: 297mm;
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
        background: #fff;
      }
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .num, .date, .chip, .meta-item, .contact-item, .header-name, .sig-name, .subject-badge {
      font-family: var(--font-ultra);
      font-weight: 400;
    }

    header.doc-header {
      padding-bottom: var(--gap-header);
      border-bottom: 0.5pt solid var(--hairline);
      margin-bottom: var(--gap-meta);
    }

    .header-main {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 4mm;
    }

    .header-name {
      font-family: var(--font-ultra);
      font-weight: 400;
      font-size: var(--font-name);
      letter-spacing: -0.022em;
      line-height: 1.1;
      color: var(--ink);
    }

    .header-role {
      font-family: var(--font-literata);
      font-weight: 500;
      font-size: var(--font-role);
      color: var(--accent);
      margin-top: 1.2mm;
      letter-spacing: -0.01em;
    }

    .header-metas {
      display: flex;
      flex-wrap: wrap;
      column-gap: 3.5mm;
      row-gap: 1.5mm;
      margin-top: 2.8mm;
      font-family: var(--font-ultra);
      font-weight: 400;
      font-size: var(--font-meta);
      color: var(--muted);
    }

    .meta-item {
      display: inline-flex;
      align-items: center;
      gap: 1.2mm;
    }

    .meta-item:not(:last-child)::after {
      content: "·";
      color: var(--faint);
      margin-left: 3.5mm;
    }

    .meta-grid {
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: start;
      gap: 6mm;
      margin-bottom: var(--gap-subject);
    }

    .recipient-block {
      display: flex;
      flex-direction: column;
      gap: 0.8mm;
    }

    .recipient-company {
      font-family: var(--font-literata);
      font-weight: 500;
      font-size: var(--font-recipient-company);
      color: var(--ink);
      letter-spacing: -0.01em;
    }

    .recipient-attn {
      font-family: var(--font-literata);
      font-weight: 400;
      font-size: var(--font-recipient-details);
      color: var(--muted);
    }

    .recipient-address {
      font-family: var(--font-literata);
      font-weight: 400;
      font-size: var(--font-recipient-details);
      color: var(--muted);
      white-space: pre-line;
    }

    .date-block {
      text-align: right;
      font-family: var(--font-ultra);
      font-weight: 400;
      font-size: var(--font-date);
      color: var(--muted);
    }

    .date-location {
      font-family: var(--font-literata);
      font-weight: 400;
      font-size: var(--font-recipient-details);
      color: var(--faint);
      margin-top: 0.5mm;
    }

    .subject-line {
      display: flex;
      align-items: baseline;
      gap: 2.5mm;
      margin-bottom: var(--gap-salutation);
      padding: 1.8mm 0;
      border-bottom: 0.5pt solid var(--hairline);
    }

    .subject-badge {
      font-family: var(--font-ultra);
      font-weight: 400;
      font-size: var(--font-subject);
      color: var(--accent);
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .subject-text {
      font-family: var(--font-literata);
      font-weight: 500;
      font-size: var(--font-subject);
      color: var(--ink);
      letter-spacing: -0.01em;
    }

    .salutation {
      font-family: var(--font-literata);
      font-weight: 400;
      font-size: var(--font-salutation);
      color: var(--ink);
      margin-bottom: var(--gap-paragraph);
    }

    .content-body {
      display: flex;
      flex-direction: column;
      gap: var(--gap-paragraph);
    }

    .content-body p {
      font-family: var(--font-literata);
      font-weight: 400;
      font-size: var(--font-body);
      line-height: var(--line-height);
      color: var(--ink);
      text-align: justify;
    }

    .content-body p strong {
      font-weight: 500;
      color: var(--ink);
    }

    ul.doc-bullets {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: var(--gap-bullet);
      margin: 1mm 0 1mm 2mm;
    }

    ul.doc-bullets li {
      position: relative;
      padding-left: 3.5mm;
      font-family: var(--font-literata);
      font-weight: 400;
      font-size: var(--font-bullet);
      line-height: var(--line-height-tight);
      color: var(--ink);
    }

    ul.doc-bullets li::before {
      content: "";
      position: absolute;
      left: 0;
      top: 0.55em;
      width: 1.4mm;
      height: 1.4mm;
      border-radius: 50%;
      background: var(--accent);
    }

    ul.doc-bullets li strong {
      font-weight: 500;
      color: var(--ink);
    }

    .signoff-block {
      margin-top: var(--gap-paragraph);
    }

    .signoff-text {
      font-family: var(--font-literata);
      font-weight: 400;
      font-size: var(--font-signoff);
      color: var(--ink);
      line-height: var(--line-height);
    }

    .signature-card {
      margin-top: var(--gap-signature);
      display: inline-flex;
      flex-direction: column;
      gap: 0.8mm;
    }

    .sig-name {
      font-family: var(--font-ultra);
      font-weight: 400;
      font-size: var(--font-sig-name);
      letter-spacing: -0.015em;
      color: var(--ink);
    }

    .sig-role {
      font-family: var(--font-literata);
      font-weight: 500;
      font-size: var(--font-sig-role);
      color: var(--accent);
    }

    @media screen {
      footer.doc-screen-footer {
        display: flex;
        justify-content: space-between;
        margin-top: 10mm;
        padding-top: 3mm;
        border-top: 0.5pt solid var(--hairline);
        font-family: var(--font-ultra);
        font-weight: 400;
        font-size: var(--font-footer);
        color: var(--faint);
      }
    }
    @media print {
      footer.doc-screen-footer {
        display: none;
      }
    }
  </style>
</head>
<body>

  <header class="doc-header">
    <div class="header-main">
      <div>
        <h1 class="header-name">{{NAME}}</h1>
        <div class="header-role">{{ROLE}}</div>
      </div>
    </div>
    <div class="header-metas">
      {{METAS}}
    </div>
  </header>

  <section class="meta-grid">
    <div class="recipient-block">
      {{RECIPIENT}}
    </div>
    <div class="date-block">
      <div class="date-val">{{DATE}}</div>
      <div class="date-location">{{LOCATION}}</div>
    </div>
  </section>

  <section class="subject-line">
    <span class="subject-badge">OBJET :</span>
    <span class="subject-text">{{SUBJECT}}</span>
  </section>

  <main class="letter-content">
    <div class="salutation">{{SALUTATION}}</div>

    <div class="content-body">
      {{CONTENT}}
    </div>

    {{BULLETS_BLOCK}}

    <div class="signoff-block">
      <p class="signoff-text">{{SIGNOFF}}</p>
    </div>

    <div class="signature-card">
      <div class="sig-name">{{SIGNATURE}}</div>
      <div class="sig-role">{{ROLE}}</div>
    </div>
  </main>

  <footer class="doc-screen-footer">
    <span>{{FOOTER_LEFT}}</span>
    <span>{{FOOTER_RIGHT}}</span>
  </footer>

</body>
</html>
