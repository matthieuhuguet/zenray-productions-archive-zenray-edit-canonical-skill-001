  const col = await tab.evaluate((sel) => { const e = document.querySelector(sel) || document.body, r = e.getBoundingClientRect(); return { x: r.x + scrollX, w: r.width, top: r.top + scrollY, bottom: r.bottom + scrollY }; }, SEL);
