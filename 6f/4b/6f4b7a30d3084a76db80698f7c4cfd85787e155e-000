import { createRequire } from "node:module";
const MOTION = "/Users/zenray/Create/Build/Productions/GithubProductions/ZenRayMotionDesign/tooling";
const require = createRequire(join(MOTION, "package.json")); const puppeteer = require("puppeteer-core");
const a = process.argv.slice(2); const get = (k, d) => { const i = a.indexOf(k); return i >= 0 ? a[i + 1] : d; };
