  </main>

  <div class="toast" id="toast">Copié dans le presse-papiers</div>

<script>
  // 18 October 2026 : Couleurs réelles migrées depuis Pika de Matthieu
  const PIKA_PALETTE = [
    '#ec7e7e', '#d97757', '#e6dfcf', '#a25942',
    '#87a878', '#5c80bc', '#c89d54', '#dad2bc'
  ];

  const state = {
    selectedDesign: 'A',
    activeFormat: 'hex',
    fg: '#ec7e7e',
    bg: '#1f1f1e'
  };

  function hexToRgb(hex) {
    const clean = hex.replace('#', '');
    const n = parseInt(clean, 16);
    return { r: (n >> 16) & 255, g: (n >> 8) & 255, b: n & 255 };
  }

  function srgbToLinear(c) {
    const v = c / 255;
    return v <= 0.04045 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4);
  }

  function luminance(hex) {
    const { r, g, b } = hexToRgb(hex);
    return 0.2126 * srgbToLinear(r) + 0.7152 * srgbToLinear(g) + 0.0722 * srgbToLinear(b);
  }

  function contrastRatio(h1, h2) {
    const l1 = luminance(h1);
    const l2 = luminance(h2);
    return ((Math.max(l1, l2) + 0.05) / (Math.min(l1, l2) + 0.05)).toFixed(2);
  }

  function rgbToHsl(r, g, b) {
    r /= 255; g /= 255; b /= 255;
    const max = Math.max(r, g, b), min = Math.min(r, g, b);
    let h = 0, s = 0, l = (max + min) / 2;
    if (max !== min) {
      const d = max - min;
      s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
      switch (max) {
        case r: h = (g - b) / d + (g < b ? 6 : 0); break;
        case g: h = (b - r) / d + 2; break;
        case b: h = (r - g) / d + 4; break;
      }
      h /= 6;
    }
    return `${Math.round(h * 360)}°, ${Math.round(s * 100)}%, ${Math.round(l * 100)}%`;
  }

  function formatColor(hex, fmt) {
    const { r, g, b } = hexToRgb(hex);
    const lr = srgbToLinear(r), lg = srgbToLinear(g), lb = srgbToLinear(b);
    if (fmt === 'rgb') return `rgb(${r}, ${g}, ${b})`;
    if (fmt === 'hsl') return `hsl(${rgbToHsl(r, g, b)})`;
    if (fmt === 'oklch') {
      const l = Math.cbrt(0.4122 * lr + 0.5363 * lg + 0.0514 * lb).toFixed(2);
      return `oklch(${l} 0.12 24°)`;
    }
    if (fmt === 'vec3') return `${lr.toFixed(2)}, ${lg.toFixed(2)}, ${lb.toFixed(2)}`;
    return hex.toLowerCase();
  }

  function showToast(msg) {
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.dataset.show = 'true';
    clearTimeout(window.__toastTimer);
    window.__toastTimer = setTimeout(() => { t.dataset.show = 'false'; }, 1600);
  }

  function renderPaletteDots() {
    document.querySelectorAll('[data-dots-container]').forEach(container => {
      const max = parseInt(container.dataset.maxDots || '8', 10);
      container.innerHTML = '';
      PIKA_PALETTE.slice(0, max).forEach(hex => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'color-dot';
        btn.style.background = hex;
        btn.title = hex;
        btn.addEventListener('click', () => {
          state.fg = hex;
          updateUI();
          navigator.clipboard?.writeText(formatColor(state.fg, state.activeFormat));
          showToast(`Couleur ${formatColor(state.fg, state.activeFormat)} copiée`);
        });
        container.appendChild(btn);
      });
    });
  }

  function updateUI() {
    document.documentElement.style.setProperty('--fg-color', state.fg);
    document.documentElement.style.setProperty('--bg-color', state.bg);
    const fgLum = luminance(state.fg);
    document.documentElement.style.setProperty('--fg-text-on-swatch', fgLum > 0.179 ? '#161616' : '#f7f7f5');

    const { r, g, b } = hexToRgb(state.fg);
    const lr = srgbToLinear(r).toFixed(2), lg = srgbToLinear(g).toFixed(2), lb = srgbToLinear(b).toFixed(2);

    document.querySelectorAll('[data-bind="fg-short"]').forEach(el => {
      el.textContent = formatColor(state.fg, state.activeFormat);
    });
    document.querySelectorAll('[data-bind="bg-hex"]').forEach(el => {
      el.textContent = state.bg;
    });
    document.querySelectorAll('[data-bind="ratio"]').forEach(el => {
      el.textContent = contrastRatio(state.fg, state.bg);
    });
    document.querySelectorAll('[data-bind="val-hex"]').forEach(el => { el.textContent = state.fg; });
    document.querySelectorAll('[data-bind="val-rgb"]').forEach(el => { el.textContent = `${r}, ${g}, ${b}`; });
    document.querySelectorAll('[data-bind="val-oklch"]').forEach(el => { el.textContent = formatColor(state.fg, 'oklch').replace('oklch(', '').replace(')', ''); });
    document.querySelectorAll('[data-bind="val-vec3"]').forEach(el => { el.textContent = `${lr}, ${lg}, ${lb}`; });

    document.querySelectorAll('[data-fmt]').forEach(btn => {
      btn.dataset.active = String(btn.dataset.fmt === state.activeFormat);
    });
    document.querySelectorAll('.proposal-col').forEach(col => {
      col.dataset.selected = String(col.dataset.design === state.selectedDesign);
    });
  }

  // Format buttons (Design A & C)
  document.querySelectorAll('[data-fmt]').forEach(btn => {
    btn.addEventListener('click', () => {
      state.activeFormat = btn.dataset.fmt;
      updateUI();
      const val = formatColor(state.fg, state.activeFormat);
      navigator.clipboard?.writeText(val);
      showToast(`Copié : ${val}`);
    });
  });

  // Direct copy rows (Design B)
  document.querySelectorAll('[data-copy-fmt]').forEach(btn => {
    btn.addEventListener('click', () => {
      const val = formatColor(state.fg, btn.dataset.copyFmt);
      navigator.clipboard?.writeText(val);
      showToast(`Copié : ${val}`);
    });
  });

  // Design chooser buttons
  document.querySelectorAll('[data-pick-design]').forEach(btn => {
    btn.addEventListener('click', () => {
      state.selectedDesign = btn.dataset.pickDesign;
      updateUI();
      copyHdaSummary();
    });
  });

  // HDA sliders
  const sliders = [
    { inId: 'in-radius', valId: 'val-radius' },
    { inId: 'in-pad', valId: 'val-pad' },
    { inId: 'in-gap-out', valId: 'val-gap-out' },
    { inId: 'in-gap-in', valId: 'val-gap-in' },
    { inId: 'in-mono', valId: 'val-mono' },
    { inId: 'in-dot', valId: 'val-dot' }
  ];
  sliders.forEach(({ inId, valId }) => {
    const input = document.getElementById(inId);
    const out = document.getElementById(valId);
    input.addEventListener('input', () => {
      const unit = input.dataset.unit || '';
      const val = `${input.value}${unit}`;
      document.documentElement.style.setProperty(input.dataset.var, val);
      out.textContent = val;
    });
  });

  // Theme toggle
  document.getElementById('themeBtn').addEventListener('click', (e) => {
    const next = document.body.dataset.theme === 'dark' ? 'light' : 'dark';
    document.body.dataset.theme = next;
    e.currentTarget.textContent = `Thème : ${next === 'dark' ? 'Sombre' : 'Clair'}`;
  });

  function copyHdaSummary() {
    const summary = `Design choisi : ${state.selectedDesign} | radius=${document.getElementById('in-radius').value}px, pad=${document.getElementById('in-pad').value}px, gapOut=${document.getElementById('in-gap-out').value}px, gapIn=${document.getElementById('in-gap-in').value}px, mono=${document.getElementById('in-mono').value}px, dot=${document.getElementById('in-dot').value}px`;
    navigator.clipboard?.writeText(summary);
    showToast(`Choix copié : Design ${state.selectedDesign}`);
  }

  document.getElementById('copyHdaBtn').addEventListener('click', copyHdaSummary);

  renderPaletteDots();
  updateUI();
</script>
</body>
