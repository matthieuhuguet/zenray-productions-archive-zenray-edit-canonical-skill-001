    <!-- DESIGN B -->
    <article class="proposal-col" data-design="B" data-selected="false">
      <div class="proposal-head">
        <h2 class="proposal-title">Design B · Liste Typo Suisse</h2>
        <span class="proposal-dims"><span class="num">252</span> × <span class="num">152</span> pt</span>
      </div>
      <p class="proposal-desc">Zéro bouton de format : les <span class="num">4</span> valeurs sont visibles en même temps en <span class="mono">AnthropicMono</span>, un clic sur une ligne la copie directement.</p>

      <div class="stage-center">
        <div class="picker-win win-b">
          <div class="b-top">
            <div class="b-circles">
              <div class="b-circle-fg" title="Couleur principale"></div>
              <div class="b-circle-bg" title="Couleur de fond"></div>
            </div>
            <div class="b-meta">
              <span><span class="num" data-bind="ratio">6.17</span>:<span class="num">1</span> · AA</span>
              <button class="eyedrop-btn" type="button" title="Pipette (⇧⌘C)">
                <svg viewBox="0 0 24 24"><path d="m14 4 6 6-2 2-6-6 2-2z"/><path d="M12 6 4 14v6h6l8-8"/></svg>
              </button>
            </div>
          </div>

          <div class="b-lines">
            <button class="b-line" type="button" data-copy-fmt="hex">
              <span class="b-val" data-bind="val-hex">#ec7e7e</span>
