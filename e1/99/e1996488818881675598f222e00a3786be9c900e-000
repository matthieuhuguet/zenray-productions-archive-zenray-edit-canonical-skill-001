    <!-- DESIGN C -->
    <article class="proposal-col" data-design="C" data-selected="false">
      <div class="proposal-head">
        <h2 class="proposal-title">Design C · Micro-Barre HUD</h2>
        <span class="proposal-dims"><span class="num">286</span> × <span class="num">74</span> pt</span>
      </div>
      <p class="proposal-desc">Format Spotlight ultra-compact sur <span class="num">2</span> lignes seulement : empreinte visuelle minimale, toujours hors du chemin.</p>

      <div class="stage-center">
        <div class="picker-win win-c">
          <div class="c-row-main">
            <div class="c-left">
              <div class="c-split-dot" title="FG / BG"></div>
              <button class="c-code-btn" type="button" data-copy-active>
                <span class="mono" data-bind="fg-short">#ec7e7e</span>
              </button>
            </div>
            <div class="c-right">
              <span class="c-ratio"><span class="num" data-bind="ratio">6.17</span> · AA</span>
              <button class="eyedrop-btn" type="button" title="Pipette (⇧⌘C)">
                <svg viewBox="0 0 24 24"><path d="m14 4 6 6-2 2-6-6 2-2z"/><path d="M12 6 4 14v6h6l8-8"/></svg>
              </button>
            </div>
          </div>

          <div class="c-row-sub">
            <div class="c-fmt-strip">
              <button class="c-fmt-item" type="button" data-fmt="hex" data-active="true">hex</button>
              <button class="c-fmt-item" type="button" data-fmt="rgb">rgb</button>
              <button class="c-fmt-item" type="button" data-fmt="oklch">oklch</button>
              <button class="c-fmt-item" type="button" data-fmt="vec3">3d</button>
            </div>
            <div class="dots-row" data-dots-container data-max-dots="6"></div>
          </div>
