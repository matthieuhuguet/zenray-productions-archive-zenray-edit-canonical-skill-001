          </div>

          <div class="a-footer">
            <div class="dots-row" data-dots-container></div>
            <div class="a-footer-right">
              <span><span class="num" data-bind="ratio">6.17</span></span>
              <button class="eyedrop-btn" type="button" title="Pipette (⇧⌘C)">
                <svg viewBox="0 0 24 24"><path d="m14 4 6 6-2 2-6-6 2-2z"/><path d="M12 6 4 14v6h6l8-8"/></svg>
              </button>
