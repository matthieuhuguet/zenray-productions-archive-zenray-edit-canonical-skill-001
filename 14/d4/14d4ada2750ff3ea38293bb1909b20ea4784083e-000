// 25 October 2026 : the papier theme reads its values from ThemeEngine.js (design B), one source for Quick Look and articles. / une seule source pour Quick Look et les articles.
async function papierCss(settings) {
  const engine = new Function(await fs.readFile(settings.qlThemeEngine, 'utf8') + '\nreturn ZRQL;')()
  const p = engine.DESIGNS.B.params
  const pal = d => `--paper:${p[d+'bg']||p[d+'Bg']};--ink:${p[d+'ink']||p[d+'Ink']};--muted:${p[d+'muted']||p[d+'Muted']};--accent:${p[d+'accent']||p[d+'Accent']};--line:${p[d+'rule']||p[d+'Rule']};--panel:${p[d+'block']||p[d+'Block']}`
  return `<style>/* theme papier, ThemeEngine.js design B, 25 October 2026 */:root{${pal('')};--body:${p.baseSize}px;--width:${p.measure}ch}@media(prefers-color-scheme:dark){:root{${pal('d')}}}body{line-height:${p.lineHeight}}header{text-align:${p.h1Align}}header .meta{justify-content:${p.h1Align}}header .lead{margin-left:auto;margin-right:auto}</style>`
}
// 23 October 2026 : digits wrapped in .num so a title in GT Sectra keeps its numbers in Anthropic Serif
const numbers = text => String(text).replace(/(\d+(?:[.,:]\d+)*)/g, '<span class="num">$1</span>')
// 26 October 2026 : fontSet gtultra sets EVERY number in GT Ultra (rule of 26 October 2026, 15:10), so digits are wrapped in .num across the whole body,
// except in code, preformatted text, scripts, styles, svg and form fields. / gtultra : tous les nombres en GT Ultra, sauf code, script, style, svg.
const SKIP_NUMBERS = new Set(['script', 'style', 'code', 'pre', 'svg', 'title', 'kbd', 'samp', 'textarea'])
// 26 October 2026, 14:30 Paris: Keep whole dates, times and units in GT Ultra, including the month.
const VALUE_MONTHS = 'January|February|March|April|May|June|July|August|September|October|November|December|janvier|février|mars|avril|mai|juin|juillet|août|septembre|octobre|novembre|décembre'
const VALUE_PATTERN = new RegExp(`(\\d{1,2}\\s+(?:${VALUE_MONTHS})(?:\\s+\\d{4})?|(?:${VALUE_MONTHS})\\s+\\d{4}|\\d{1,2}:\\d{2}(?:\\s*[AP]M)?|\\d+(?:[.,]\\d+)?\\s*(?:€|%|MiB|Ko|px|kg|cm|minutes?|hours?)|\\d+(?:[.,:]\\d+)*)`, 'giu')
export const wholeNumericValues = text => String(text).replace(VALUE_PATTERN, '<span class="num">$1</span>')
const numbersInBody = html => {
  const at = html.search(/<body[\s>]/)
  if (at < 0) throw new Error('fontSet gtultra: template has no <body>')
  let depth = 0
  const body = html.slice(at).split(/(<[^>]+>|&#?\w+;)/).map(part => {
    const tag = /^<(\/?)([a-zA-Z][a-zA-Z0-9]*)/.exec(part)
    if (tag) { if (SKIP_NUMBERS.has(tag[2].toLowerCase()) && !part.endsWith('/>')) depth = Math.max(0, depth + (tag[1] ? -1 : 1)); return part }
    return part.startsWith('&') || depth > 0 ? part : wholeNumericValues(part)
  }).join('')
  return html.slice(0, at) + body
}
const escape = value => String(value ?? '').replace(/[&<>"']/g, c => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[c]))
const mimeOf = name => ({'.png':'image/png','.webp':'image/webp','.jpg':'image/jpeg','.jpeg':'image/jpeg','.svg':'image/svg+xml'}[path.extname(name).toLowerCase()] || 'application/octet-stream')

export async function renderProjectArticle(configFile, outFile, settings = ARTICLE_SETTINGS) {
  const root = path.dirname(path.resolve(configFile))
  const config = JSON.parse(await fs.readFile(configFile, 'utf8'))
  const sources = JSON.parse(await fs.readFile(path.join(root, config.sources), 'utf8'))
  const assets = new Map()
  for (const file of sources.files) {
    const source = path.resolve(root, file.path)
    if (!source.startsWith(root + path.sep)) throw new Error('Article resource leaves its source folder')
    const bytes = await fs.readFile(source)
    if (createHash('sha256').update(bytes).digest('hex') !== file.sha256) throw new Error(`Source changed: ${file.path}`)
    assets.set(file.id, { ...file, data:`data:${mimeOf(source)};base64,${bytes.toString('base64')}` })
  }
  const image = (id, caption, alt = caption) => {
    const asset = assets.get(id)
    if (!asset) throw new Error(`Missing illustration: ${id}`)
    return `<figure id="figure-${escape(id)}"><a href="#files"><img src="${asset.data}" alt="${escape(alt)}" loading="lazy"></a><figcaption>${caption}</figcaption></figure>`
  }
  const sections = config.sections.map(section => {
    let body = section.html || ''
    // 20 October 2026, 18:28 CEST: compact figure groups retain optional references without lengthening the reading.
    if (section.figures?.length) body += '<div class="figure-grid">' + section.figures.map(figure => {
      const markup = image(figure.id, figure.caption)
      return figure.collapsed ? `<details class="reference"><summary>${escape(figure.label || 'Voir la référence')}</summary>${markup}</details>` : markup
    }).join('') + '</div>'
    if (section.prompts) body += section.prompts.map(prompt => `<details class="prompt"${prompt.open ? ' open' : ''}><summary>${escape(prompt.title)} · ${escape(prompt.date)}</summary><p class="prompt-text">${escape(prompt.text)}</p></details>`).join('')
    if (section.fileIndex) {
      const table = `<div class="table-wrap"><table><thead><tr><th>Fichier</th><th>Ce qu’il apporte</th><th>Original conservé</th></tr></thead><tbody>${sources.files.map(file => `<tr><td><a href="#${escape(config.fileAnchors?.[file.id] || `figure-${file.id}`)}">${escape(config.fileLabels[file.id])}</a><br><code>${escape(file.path)}</code></td><td>${escape(config.fileRoles[file.id])}</td><td><code>${escape(file.originalPath)}</code><br>${file.bytes.toLocaleString('fr-FR')} octets · SHA-256 dans le manifeste</td></tr>`).join('')}</tbody></table></div>`
      body += section.fileIndexCollapsed ? `<details><summary>Voir les ${sources.files.length} fichiers et leur provenance</summary>${table}</details>` : table
    }
    return `<section id="${escape(section.id)}"><div class="eyebrow">${escape(section.eyebrow || '')}</div><h2>${escape(section.title)}</h2>${body}</section>`
  }).join('\n')
  const fontSet = config.fontSet || settings.defaultFontSet
  if (!['sectra', 'gtstandard', 'gtultra'].includes(fontSet)) throw new Error(`Unknown fontSet "${fontSet}" (sectra, gtstandard or gtultra)`)
  const titleItalic = fontSet === 'sectra' && (config.titleStyle || 'italic') === 'italic' // 23 October 2026 : italic is the default (rules/Typography1.md, 18:20); "normal" keeps upright titles
  const fontList = fontSet === 'gtultra' ? settings.gtUltraFonts : fontSet === 'gtstandard' ? settings.gtStandardFonts : (titleItalic ? [...settings.fonts, settings.italicTitleFont] : settings.fonts)
  const fonts = (await Promise.all(fontList.map(async ([family, name, format, weight, style = 'normal']) => `@font-face{font-family:'${family}';font-style:${style};font-weight:${weight};font-display:swap;src:url(data:font/${format === 'truetype' ? 'ttf' : format};base64,${(await fs.readFile(path.isAbsolute(name) ? name : path.join(settings.fontRoot,name))).toString('base64')}) format('${format}')}`))).join('\n')
  const values = Object.fromEntries(['title','eyebrow','lead','date','subtitle','status','heroAlt','heroText','heroCaption','footer'].map(key=>[key.replace(/[A-Z]/g,c=>'_'+c).toUpperCase(),escape(config[key])]))
  Object.assign(values,{FONTS:fonts,HERO:assets.get(config.hero).data,NAV:config.sections.map(section=>`<a href="#${escape(section.id)}">${escape(section.nav || section.title)}</a>`).join(''),SECTIONS:sections})
  const template = await fs.readFile(settings.template,'utf8')
  const html = template.replace(/\{\{([A-Z_]+)\}\}/g,(_,key)=>{if (!(key in values)) throw new Error(`Unknown template value ${key}`);return values[key]})
  // 23 October 2026 : every number inside a title is set back in Anthropic Serif (rule of 23 October 2026, 13:50)
  const titled = fontSet === 'gtultra' ? numbersInBody(html) : html.replace(/<(h[1-3])([^>]*)>([\s\S]*?)<\/\1>/g, (_, tag, attrs, inner) => `<${tag}${attrs}>${inner.split(/(<[^>]+>|&#?\w+;)/).map(part => /^(<|&)/.test(part) ? part : numbers(part)).join('')}</${tag}>`)
  // Italic titles only; every number keeps its upright Anthropic Serif through `.num` (higher specificity). / titres seuls en italique, les chiffres restent droits.
  const finalHtml = titleItalic ? titled.replace('</head>', '<style>h1,h2,h3{font-style:italic}</style></head>') : titled
  if (titleItalic && finalHtml === titled) throw new Error('titleStyle italic: template has no </head>')
  const theme = config.theme || settings.defaultTheme
  if (!['papier', 'galerie'].includes(theme)) throw new Error(`Unknown article theme "${theme}" (papier or galerie)`)
  const themed = theme === 'papier' ? finalHtml.replace('</head>', (await papierCss(settings)) + '</head>') : finalHtml
  const overrideCss = fontSet === 'gtultra' ? settings.gtUltraCss : fontSet === 'gtstandard' ? settings.gtStandardCss : ''
  let output = overrideCss ? themed.replace('</head>', overrideCss + '</head>') : themed
  if (overrideCss && output === themed) throw new Error(`fontSet ${fontSet}: template has no </head>`)
  // 30 October 2026, 02:10 CET: the opt-in editor is embedded only in review articles.
  if (config.editor === true) {
    const editorRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '../templates/project-article/editor')
    const editorCss = await fs.readFile(path.join(editorRoot, 'editor.css'), 'utf8')
    const editorJs = await fs.readFile(path.join(editorRoot, 'editor.js'), 'utf8')
    if (!output.includes('</head>') || !output.includes('</body>')) throw new Error('Editor requires complete article HTML')
    output = output.replace('</head>', `<style>${editorCss}</style></head>`).replace('</body>', `<script>${editorJs}</script></body>`)
  }
  await fs.writeFile(outFile,output)
  return {path:path.resolve(outFile),bytes:Buffer.byteLength(output),sha256:createHash('sha256').update(output).digest('hex'),illustrations:sources.files.filter(file => mimeOf(file.path).startsWith('image/')).length}
}
if (process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
  if (!process.argv[2] || !process.argv[3]) throw new Error('Usage: render-project-article.mjs <definition.json> <index.html>')
  console.log(JSON.stringify(await renderProjectArticle(process.argv[2],process.argv[3])))
}
